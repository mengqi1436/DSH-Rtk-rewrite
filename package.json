    "deepseek-harness",
    "shell",
    "token-savings"
  ],
  "license": "MIT",
  "author": "mengqi1436",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengqi1436/DSH-Rtk-rewrite.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-pwsh-sandbox": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
